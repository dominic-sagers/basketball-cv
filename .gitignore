# All large assets live in store/ — tracked by DVC, not git (dvc pull to restore)
# /store entry below is managed by DVC (dvc add store)
/store

# Test-environment server storage (docker-compose.test.yml) — never DVC-tracked,
# kept out of /store on purpose so test recordings can't mix into real game data
/test-store

